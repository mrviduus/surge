# Top-level config for LoadSurge
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# Explicit usings, block namespaces (project convention; ImplicitUsings disabled)
csharp_style_namespace_declarations = block_scoped:warning
dotnet_sort_system_directives_first = true

# var preferences match existing code
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# CA1510 (ArgumentNullException.ThrowIfNull): not available on netstandard2.0;
# a single explicit-throw code path is kept for both TFMs instead of #if forks
dotnet_diagnostic.CA1510.severity = none

[*.{csproj,props,targets,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
